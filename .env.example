# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only email allowed to sign in (PRD: single-user, no public signup).
# Create this user in Supabase Auth (Authentication -> Users -> Add user) first.
OWNER_EMAIL=

# Server-only: used by the LINE webhook and daily cron (no browser session there).
# Never exposed to the client. Supabase → Project Settings → API Keys → secret / service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (F04)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# AI chat analysis (F06/F09) — provider-agnostic abstraction; the bundled default
# implementation calls Anthropic's Messages API, so AI_PROVIDER_API_KEY is an
# Anthropic API key and AI_MODEL a Claude model id (e.g. claude-sonnet-4-5).
# Swap src/lib/ai-extraction/provider.ts's AiExtractionProvider implementation
# to use a different vendor.
AI_PROVIDER_API_KEY=
AI_MODEL=
# Soft budget cap, tracked in app_settings — not yet enforced by any spend check
# before calling the model (see README "Known limitations").
AI_MONTHLY_BUDGET_CENTS=

# LINE OA assistant (Messaging API channel → Basic settings / Messaging API tabs)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Your own LINE userId (the bot replies with it the first time you message it).
LINE_OWNER_USER_ID=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/line-daily.
CRON_SECRET=
# Free OCR for business-card / profile screenshots (https://ocr.space/ocrapi/freekey). Optional.
OCR_SPACE_API_KEY=
# Public base URL used in links the bot sends (defaults to the Vercel production URL).
APP_BASE_URL=
